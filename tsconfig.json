{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "lib": ["ES2022"],
    "types": ["node"],
    "paths": {
      "@intrilex/shared": ["./packages/shared/src/canonical.mjs"],
      "@intrilex/shared/version": ["./packages/shared/src/version.mjs"],
      "@intrilex/shared/provenance": ["./packages/shared/src/provenance.mjs"],
      "@intrilex/shared/release-identity": ["./packages/shared/src/release-identity.mjs"],
      "@intrilex/statistics": ["./packages/statistics/src/statistics.mjs"],
      "@intrilex/match-authority": ["./packages/match-authority/src/authoritative-match-session.mjs"],
      "@intrilex/match-authority/match-store": ["./packages/match-authority/src/match-store.mjs"],
      "@intrilex/match-authority/matchmaking-queue": ["./packages/match-authority/src/matchmaking-queue.mjs"],
      "@intrilex/match-authority/player-projection": ["./packages/match-authority/src/player-projection.mjs"],
      "@intrilex/network-protocol": ["./packages/network-protocol/src/protocol.mjs"],
      "@intrilex/network-protocol/reason-codes": ["./packages/network-protocol/src/reason-codes.mjs"],
      "@intrilex/network-protocol/validation": ["./packages/network-protocol/src/validation.mjs"],
      "@intrilex/achievements": ["./packages/achievements/src/index.mjs"],
      "@intrilex/account-domain": ["./packages/account-domain/src/index.mjs"],
      "@intrilex/account-domain/profile-domain": ["./packages/account-domain/src/profile-domain.mjs"]
    }
  },
  "include": [
    "packages/shared/src/**/*.mjs",
    "packages/statistics/src/**/*.mjs",
    "packages/match-authority/src/**/*.mjs",
    "packages/achievements/src/**/*.mjs",
    "packages/network-protocol/src/**/*.mjs"
  ],
  "exclude": [
    "node_modules",
    "apps",
    "test",
    "scripts",
    "runtime",
    "vendor",
    "upstream",
    "release"
  ]
}
