# Intrilex Match Server — Production Environment File
#
# Install:
#   sudo mkdir -p /etc/intrilex
#   sudo cp match-server.env /etc/intrilex/match-server.env
#   sudo chown root:intrilex /etc/intrilex/match-server.env
#   sudo chmod 640 /etc/intrilex/match-server.env
#
# NEVER commit this file with real secrets to Git.
# This template contains ONLY non-secret values.
# Replace the SECRET placeholders with actual values on the server.

# ── Environment ──
NODE_ENV=production

# ── Server binding ──
# Bind to loopback only — Caddy handles public TLS/WSS
HOST=127.0.0.1
PORT=3099

# ── Authentication ──
INTRILEX_AUTH_MODE=required

# Supabase (server-side identity verification)
SUPABASE_URL=https://xczwhiqnvyxubywhpxiv.supabase.co
# REPLACE THIS with the actual secret key (do NOT commit the real value):
SUPABASE_SECRET_KEY=REPLACE_WITH_ACTUAL_SUPABASE_SECRET_KEY

# ── WebSocket origin allowlist ──
# Only the production frontend origin may connect
INTRILEX_ALLOWED_ORIGINS=https://intrilex.cards

# ── Proxy trust ──
# Trust X-Forwarded-For from Caddy (local reverse proxy)
INTRILEX_TRUST_PROXY=1

# ── Public features ──
# Matchmaking: enable for production (players can find random opponents)
INTRILEX_PUBLIC_MATCHMAKING=1
# Match history: enable if public spectator/history is desired
INTRILEX_PUBLIC_HISTORY=0

# ── Logging ──
INTRILEX_LOG=1
