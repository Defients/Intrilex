# Intrilex Match Server — Caddy reverse proxy configuration
#
# Install:
#   sudo cp Caddyfile.match.intrilex /etc/caddy/
#   sudo caddy reload --config /etc/caddy/Caddyfile
#
# Or if Caddy uses a single Caddyfile, append the contents of this file
# to the existing /etc/caddy/Caddyfile and reload.
#
# Caddy automatically:
#   - obtains TLS certificates from Let's Encrypt
#   - renews certificates before expiry
#   - proxies WebSocket upgrade traffic
#   - redirects HTTP -> HTTPS
#
# The match server itself runs on 127.0.0.1:3099 (loopback only).
# Port 3099 is NOT exposed to the public internet.

match.intrilex.cards {
    # Reverse proxy to the Intrilex match server
    reverse_proxy 127.0.0.1:3099 {
        # WebSocket support is automatic in Caddy — no special headers needed.
        # Caddy handles the Upgrade/Connection headers transparently.

        # Trust upstream for health checking
        health_uri /health
        health_timeout 5s
    }

    # Basic security headers
    # X-Frame-Options DENY and Content-Security-Policy frame-ancestors 'none'
    # provide defense-in-depth against clickjacking. The CSP <meta> tag in the
    # frontend's index.html cannot enforce frame-ancestors (ignored per CSP
    # spec when delivered via <meta>), so it must be set as an HTTP header.
    # The match server sets it here for any HTML it serves (e.g., /health
    # responses, error pages). The frontend on Neocities relies on the
    # _headers file (forward-compatible) since Neocities doesn't support
    # custom HTTP headers.
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Content-Security-Policy: frame-ancestors 'none'
    }

    # Log access
    log {
        output file /var/log/caddy/match.intrilex.cards.log {
            roll_size 100mb
            roll_keep 5
        }
    }
}
