# ═══════════════════════════════════════════════════════════════
# Intrilex Account Infrastructure — Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in real values.
# NEVER commit real credentials to the repository.

# ── Browser-safe (published to client bundle) ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# ── Server only (NEVER browser-bundled) ──
SUPABASE_SECRET_KEY=your-service-role-secret-key

# ── Account system ──
# Auth mode: 'required' (production), 'disabled' (development only)
INTRILEX_AUTH_MODE=required

# ── Optional deployment configuration ──
# Public origin for OAuth redirects (e.g. https://intrilex.example.com)
INTRILEX_PUBLIC_ORIGIN=http://localhost:3000
# Match server origin (for WebSocket connections)
INTRILEX_MATCH_SERVER_ORIGIN=ws://localhost:3099
# Allowed WebSocket origins (comma-separated)
INTRILEX_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Supabase local development (supabase start) ──
# These are auto-configured by the Supabase CLI for local dev.
# Do not set manually unless overriding.
# SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:54322/postgres
